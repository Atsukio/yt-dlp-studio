<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YT DLP Studio" Width="1060" Height="760" MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource Text}" Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Colour brushes (WindowBg, CardBg, Accent, ...) are added from code to match the Windows light/dark setting. -->
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- ============ Scrollbars ============ -->
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" CornerRadius="3" Background="{DynamicResource ScrollThumb}" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="VScroll" TargetType="ScrollBar">
            <Grid Background="Transparent" Width="10">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinHeight="36"/></Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="HScroll" TargetType="ScrollBar">
            <Grid Background="Transparent" Height="10">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinWidth="36"/></Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Template" Value="{StaticResource VScroll}"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template" Value="{StaticResource HScroll}"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Cards & text ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ Buttons ============ -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Text boxes ============ -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <!-- TextBox applies Padding to its content itself, so the host gets no margin. -->
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <TextBlock x:Name="Hint" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{DynamicResource SubText}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputFocusBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CellBox" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="LogBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource LogBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource LogText}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="10,8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Toggle switch & check box ============ -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" VerticalAlignment="Center"
                                    Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource SubText}" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="3,0,0,0"
                                         Fill="{DynamicResource SubText}">
                                    <Ellipse.RenderTransform><TranslateTransform X="0"/></Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentText}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Duration="0:0:0.16" To="20"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Duration="0:0:0.16" To="0"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource SubText}" BorderThickness="1">
                            <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Navigation pills ============ -->
        <Style x:Key="NavPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="16,7" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PillActive}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Sidebar list ============ -->
        <Style x:Key="SideItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Padding="12,7" Margin="0,1" Background="Transparent">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" Margin="-9,0,0,0"
                                        HorizontalAlignment="Left" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PillActive}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Progress bar ============ -->
        <Style x:Key="Progress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track" CornerRadius="2" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                            <Border x:Name="Runner" CornerRadius="2" Width="180" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" Visibility="Collapsed">
                                <Border.RenderTransform><TranslateTransform X="-180"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Runner" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="RunnerAnim">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Runner" From="-180" To="1600" Duration="0:0:1.8"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="RunnerAnim"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Options grid ============ -->
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="10,8" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RowLine}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Selection}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="8,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Segmented control, icon buttons, pills ============ -->
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="GroupName" Value="fmt"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="CardBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource CardBtn}">
            <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,1,7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ Drop-down ============ -->
        <Style x:Key="ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="5" Padding="10,7" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Padding" Value="12,8,34,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1"
                                                Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource ControlBorder}">
                                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,12,0"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubText}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                        CornerRadius="8" Padding="4" Margin="0,4,0,0" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Download card ============ -->
        <DataTemplate x:Key="ItemCard">
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="128" Height="72" VerticalAlignment="Top">
                        <Border CornerRadius="6" Background="{DynamicResource ControlBg}">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource SubText}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <Rectangle RadiusX="6" RadiusY="6">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Border Background="#B3000000" CornerRadius="4" Padding="5,1,5,2" Margin="5"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Visibility="{Binding HasDuration, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="11"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <DockPanel>
                            <Border Style="{StaticResource Pill}" Margin="0,0,8,0" DockPanel.Dock="Left">
                                <TextBlock Text="{Binding FormatLabel}" Style="{StaticResource PillText}"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" ToolTip="{Binding Title}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Uploader}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasUploader, Converter={StaticResource BoolVis}}"/>
                        <ProgressBar Style="{StaticResource Progress}" Maximum="100" Margin="0,10,0,0"
                                     Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                     Visibility="{Binding ShowProgress, Converter={StaticResource BoolVis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ShowStats, Converter={StaticResource BoolVis}}">
                            <Border Style="{StaticResource Pill}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Speed}" Style="{StaticResource PillText}"/>
                            </Border>
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PercentText}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EtaText}" Style="{StaticResource Caption}" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="Status" Text="{Binding StatusText}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"
                                   Visibility="{Binding ShowStatus, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource CardBtn}" Command="{Binding OpenCommand}" ToolTip="Show in folder"
                                Visibility="{Binding HasFile, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource CardBtn}" Command="{Binding RetryCommand}" ToolTip="Retry"
                                Visibility="{Binding CanRetry, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource DangerBtn}" Command="{Binding CancelCommand}" ToolTip="Cancel"
                                Visibility="{Binding CanCancel, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource CardBtn}" Command="{Binding RemoveCommand}" ToolTip="Remove from list"
                                Visibility="{Binding IsFinished, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="failed">
                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="done">
                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Success}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="LogoImage" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="YT DLP Studio" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText" Text="Powered by yt-dlp" Style="{StaticResource Caption}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="9" Padding="3"
                        Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="NavHome" Style="{StaticResource NavPill}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Home"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavDownloads" Style="{StaticResource NavPill}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Downloads"/>
                                <Border x:Name="DlBadge" CornerRadius="8" Padding="6,0" Margin="8,0,0,0" MinWidth="18"
                                        Background="{DynamicResource Accent}" Visibility="Collapsed" VerticalAlignment="Center">
                                    <TextBlock x:Name="DlBadgeText" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AccentText}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavOptions" Style="{StaticResource NavPill}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Options"/>
                                <Border x:Name="OptBadge" CornerRadius="8" Padding="6,0" Margin="8,0,0,0" MinWidth="18"
                                        Background="{DynamicResource Accent}" Visibility="Collapsed" VerticalAlignment="Center">
                                    <TextBlock x:Name="OptBadgeText" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AccentText}"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Style="{StaticResource IconBtn}" ToolTip="Update yt-dlp">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="15"/>
                    </Button>
                    <Button x:Name="HeaderFolderButton" Style="{StaticResource IconBtn}" ToolTip="Open download folder" Margin="4,0,0,0">
                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="15"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Home page ================= -->
        <ScrollViewer x:Name="HomePage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="780" Margin="28,36,28,28">
                <!-- Shown while yt-dlp / ffmpeg are being downloaded, or when one is missing. -->
                <Border x:Name="SetupCard" Style="{StaticResource Card}" Margin="0,0,0,28" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                            <TextBlock x:Name="SetupIcon" Text="&#xE896;" Style="{StaticResource Icon}" FontSize="16"
                                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,1,14,0">
                            <TextBlock x:Name="SetupTitle" Style="{StaticResource Heading}"/>
                            <TextBlock x:Name="SetupDetail" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="SetupProgress" Style="{StaticResource Progress}" Maximum="100" Margin="0,12,0,2"/>
                        </StackPanel>
                        <Button x:Name="SetupButton" Grid.Column="2" Style="{StaticResource AccentBtn}" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="SetupButtonText" Text="Download"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Text="Download music and video" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="YouTube, SoundCloud, Bandcamp and thousands of other sites" Style="{StaticResource Caption}" FontSize="13.5"
                           HorizontalAlignment="Center" Margin="0,8,0,26"/>

                <TextBox x:Name="UrlBox" Style="{StaticResource Input}" Height="110" FontSize="14" Padding="14,12"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Tag="Paste one or more links, one per line"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PasteButton" Style="{StaticResource Btn}" Padding="14,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77F;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Paste from clipboard"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CheckButton" Style="{StaticResource Btn}" Padding="14,9" Margin="8,0,0,0" IsEnabled="False"
                                ToolTip="Look up this link's available formats (one link at a time)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Check formats"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Ctrl+Enter" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button x:Name="DownloadButton" Grid.Column="2" Style="{StaticResource AccentBtn}" Padding="26,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                            <TextBlock Text="Download"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Filled by "Check formats": the video's details and its actual formats. -->
                <Border x:Name="PreviewCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="160" Height="90" VerticalAlignment="Top">
                                <Border CornerRadius="6" Background="{DynamicResource ControlBg}">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="24" Foreground="{DynamicResource SubText}" HorizontalAlignment="Center"/>
                                </Border>
                                <Rectangle x:Name="PreviewThumb" RadiusX="6" RadiusY="6"/>
                                <Border x:Name="PreviewDurationPill" Background="#B3000000" CornerRadius="4" Padding="5,1,5,2" Margin="5"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed">
                                    <TextBlock x:Name="PreviewDuration" Foreground="White" FontSize="11"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="16,2,12,0">
                                <TextBlock x:Name="PreviewTitle" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PreviewMeta" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,6,0,0"/>
                                <TextBlock x:Name="PreviewStatus" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="PreviewProgress" Style="{StaticResource Progress}" IsIndeterminate="True" Margin="0,12,0,0"/>
                            </StackPanel>
                            <Button x:Name="PreviewClose" Grid.Column="2" Style="{StaticResource IconBtn}" VerticalAlignment="Top" ToolTip="Close">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12"/>
                            </Button>
                        </Grid>
                        <StackPanel x:Name="PreviewFormats" Margin="0,16,0,0">
                            <UniformGrid Rows="1">
                                <StackPanel x:Name="PreviewVideoPanel" Margin="0,0,6,0">
                                    <TextBlock Text="Video" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="PreviewVideoCombo" Style="{StaticResource Combo}"/>
                                </StackPanel>
                                <StackPanel x:Name="PreviewAudioPanel" Margin="6,0,0,0">
                                    <TextBlock Text="Audio" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="PreviewAudioCombo" Style="{StaticResource Combo}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="PreviewSize" Style="{StaticResource Caption}" FontSize="12.5" Margin="2,10,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,28,0,0">
                    <StackPanel>
                        <TextBlock Text="Format" Style="{StaticResource Heading}"/>
                        <Border CornerRadius="8" Padding="3" Margin="0,10,0,0" Background="{DynamicResource ControlBg}"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="FmtMp3" Style="{StaticResource Seg}" Content="MP3" IsChecked="True"/>
                                <RadioButton x:Name="FmtM4a" Style="{StaticResource Seg}" Content="M4A"/>
                                <RadioButton x:Name="FmtFlac" Style="{StaticResource Seg}" Content="FLAC"/>
                                <RadioButton x:Name="FmtWav" Style="{StaticResource Seg}" Content="WAV"/>
                                <RadioButton x:Name="FmtVideo" Style="{StaticResource Seg}" Content="Video (MP4)"/>
                                <RadioButton x:Name="FmtCustom" Style="{StaticResource Seg}" Content="Custom"/>
                            </UniformGrid>
                        </Border>
                        <UniformGrid x:Name="QualityRow" Rows="1" Margin="0,14,0,0">
                            <StackPanel x:Name="AudioQualityPanel" Margin="0,0,6,0">
                                <TextBlock Text="Audio quality" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="AudioQualityCombo" Style="{StaticResource Combo}"/>
                            </StackPanel>
                            <StackPanel x:Name="VideoQualityPanel" Margin="0,0,6,0">
                                <TextBlock Text="Video quality" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="VideoQualityCombo" Style="{StaticResource Combo}"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock x:Name="QualityNote" Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="FormatHint" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" Margin="2,10,0,0"
                                   TextWrapping="Wrap"/>
                        <Border Height="1" Background="{DynamicResource CardBorder}" Margin="0,16"/>
                        <CheckBox x:Name="EmbedCheck" Style="{StaticResource Switch}">
                            <StackPanel>
                                <TextBlock Text="Add cover art and tags" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                    <Run Text="Embeds the thumbnail and title/artist metadata  ·  "/><Run Text="--embed-thumbnail --embed-metadata" FontFamily="{StaticResource MonoFont}"/>
                                </TextBlock>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Save to" Style="{StaticResource Heading}" Margin="0,0,0,10" Grid.ColumnSpan="3"/>
                        <TextBox x:Name="FolderBox" Grid.Row="1" Style="{StaticResource Input}" Tag="Output folder"/>
                        <Button x:Name="BrowseButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource Btn}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Browse"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenFolderButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                ToolTip="Open folder in Explorer">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <TextBlock x:Name="YtIcon" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource SubText}" Text="&#xE9F5;"/>
                    <TextBlock x:Name="YtStatus" Style="{StaticResource Caption}" Margin="6,0,20,0" Text="yt-dlp: checking..."/>
                    <TextBlock x:Name="FfIcon" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource SubText}" Text="&#xE9F5;"/>
                    <TextBlock x:Name="FfStatus" Style="{StaticResource Caption}" Margin="6,0,0,0" Text="ffmpeg: checking..."/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= Downloads page ================= -->
        <Grid x:Name="DownloadsPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,22,28,16">
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Downloading" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Pill}" Margin="10,0,0,0">
                                <TextBlock x:Name="ActiveCount" Text="0" Style="{StaticResource PillText}"/>
                            </Border>
                        </StackPanel>
                        <Button x:Name="LogToggle" Style="{StaticResource GhostBtn}" Padding="12,6" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock x:Name="LogToggleText" Text="Show log"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ItemsControl x:Name="ActiveList" ItemTemplate="{StaticResource ItemCard}"/>
                    <Border x:Name="ActiveEmpty" CornerRadius="8" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Padding="16,22">
                        <TextBlock Text="Nothing downloading right now. Paste some links on the Home page." Style="{StaticResource Caption}"
                                   FontSize="13" HorizontalAlignment="Center"/>
                    </Border>

                    <Grid Margin="0,28,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE930;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Completed" Style="{StaticResource SectionTitle}"/>
                            <Border Style="{StaticResource Pill}" Margin="10,0,0,0">
                                <TextBlock x:Name="DoneCount" Text="0" Style="{StaticResource PillText}"/>
                            </Border>
                        </StackPanel>
                        <Button x:Name="ClearDoneButton" Style="{StaticResource GhostBtn}" Padding="12,6" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE894;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Clear list"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ItemsControl x:Name="DoneList" ItemTemplate="{StaticResource ItemCard}"/>
                    <StackPanel x:Name="DoneEmpty" Margin="0,30,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="34" Foreground="{DynamicResource SubText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No completed downloads yet" Style="{StaticResource Caption}" FontSize="13.5" Margin="0,12,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="LogPanel" Grid.Row="1" Style="{StaticResource Card}" Margin="28,0,28,24" Padding="12" Height="190" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,0,8">
                        <TextBlock Text="Log" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
                        <Button x:Name="ClearLogButton" Style="{StaticResource GhostBtn}" Padding="10,4" Content="Clear"
                                Foreground="{DynamicResource SubText}" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource LogBox}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Options page ================= -->
        <Grid x:Name="OptionsPage" Grid.Row="1" Margin="28,18,28,28" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="8">
                <ListBox x:Name="SectionList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                         ItemContainerStyle="{StaticResource SideItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{DynamicResource SubText}" FontSize="12"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Padding="34,7,10,7" Tag="Search options and descriptions"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource SubText}"
                                   Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <TextBlock x:Name="CountText" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,6,0"/>
                        <Button x:Name="ClearOptionsButton" Grid.Column="2" Style="{StaticResource GhostBtn}" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE894;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Clear all"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <DataGrid x:Name="OptionGrid" Grid.Row="1" Margin="4,0,4,4"
                              AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                              Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource Text}" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              CanUserReorderColumns="False" CanUserSortColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              ColumnHeaderStyle="{StaticResource GridHeader}" RowStyle="{StaticResource GridRow}"
                              CellStyle="{StaticResource GridCell}"
                              VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="46">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource Check}" HorizontalAlignment="Center"
                                                  IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="OPTION" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding MetavarText, Mode=OneWay}" Foreground="{DynamicResource SubText}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="VALUE" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Style="{StaticResource CellBox}" Tag="{Binding Metavar}"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding TakesValue, Converter={StaticResource BoolVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="DESCRIPTION" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SubText}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="DescTitle" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Text="Select an option"/>
                    <TextBlock x:Name="DescMeta" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                    <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <TextBlock x:Name="DescBody" TextWrapping="Wrap" Foreground="{DynamicResource SubText}" LineHeight="19"
                                   Text="Loading options from yt-dlp..."/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Extra arguments" Style="{StaticResource Heading}"/>
                        <TextBlock Text="Typed as on the command line" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="ExtraBox" Grid.Column="1" Style="{StaticResource Input}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             Tag="e.g. options you need more than once:  --parse-metadata &quot;...&quot; --parse-metadata &quot;...&quot;"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
